# Session Parity Kit — пример окружения.
# Все значения валидируются на старте. Секреты только здесь, не в коде.

SPK_ENV=dev

# --- HTTP API ---
SPK_API_HOST=127.0.0.1
SPK_API_PORT=8080
# Метрики воркеров отдаются отдельным портом: счётчики живут в процессе,
# который их считает. Prometheus скрейпит api:8080/metrics и worker:9090/metrics.
SPK_METRICS_PORT=9090

# --- Хранилище и очередь ---
# store: SQLite всегда источник истины (jobs, profiles).
SPK_STORE_PATH=./var/spk.db

# queue_backend: sqlite | redis
# sqlite — локальный запуск, один хост.
# redis  — несколько хостов, горизонтальное масштабирование.
SPK_QUEUE_BACKEND=sqlite
SPK_REDIS_URL=redis://127.0.0.1:6379/0
SPK_QUEUE_NAME=spk:queue
SPK_QUEUE_LEASE_SECONDS=180

# --- Пулы ---
SPK_WORKER_COUNT=4
SPK_PROFILE_FILE=./var/profiles.json
SPK_JOB_ATTEMPT_LIMIT=3
SPK_MAX_CONCURRENT_PER_HOST=64

# --- Таймауты (секунды) ---
SPK_HTTP_CONNECT_TIMEOUT=10.0
SPK_HTTP_READ_TIMEOUT=25.0
SPK_CHALLENGE_TIMEOUT=180.0
SPK_VERIFY_TIMEOUT=20.0
SPK_BACKOFF_BASE=0.5
SPK_BACKOFF_MAX=30.0

# --- Целевая платформа (наблюдено, см. prompts/ref/) ---
SPK_AUTH_BASE=https://auth.roblox.com
SPK_VERIFY_URL=https://users.roblox.com/v1/users/authenticated
SPK_ORIGIN=https://www.roblox.com
SPK_REFERER=https://www.roblox.com/login

# --- Узел проверки ---
# challenge_provider: playwright
SPK_CHALLENGE_PROVIDER=playwright
SPK_PLAYWRIGHT_HEADLESS=true
SPK_PLAYWRIGHT_BROWSER=chromium

# Браузерный путь стоит ~5 МиБ на поток (см. docs/COST.md).
# Держать выключенным, пока не нужен: скорость даёт HTTP-конвейер.
SPK_CHALLENGE_BROWSER_ENABLED=true
SPK_BROWSER_BLOCK_ASSETS=true
SPK_PX_HOLD_SECONDS=12
SPK_PX_SESSION_WAIT=45

# --- Логи ---
SPK_LOG_LEVEL=INFO
SPK_LOG_JSON=true
SPK_CAPTURE_FIXTURES=false
SPK_FIXTURES_DIR=./fixtures

# --- Губернатор пар «аккаунт + профиль» (docs/GATE.md) ---
# Платформа разрешает вход паре с ограниченной частотой и расходует кредит
# доверия после серии успехов. Губернатор не даёт сервису сжигать аккаунты.
SPK_PAIR_GOVERNOR_ENABLED=true
SPK_PAIR_MIN_INTERVAL=180
SPK_PAIR_COOLDOWN_BASE=300
SPK_PAIR_COOLDOWN_MAX=3600
# --- Подпись входа и HTTP-прохождение проверки (docs/POW.md) ---
# С подписью secureAuthenticationIntent платформа выдаёт вычислимую задачу
# proof-of-work вместо капчи, а токен второй ступени отдаёт без интерактива.
SPK_SAI_ENABLED=true
SPK_HTTP_CHALLENGE_ENABLED=true
# Предел сложности PoW: выше — считаем, что платформа отказала.
SPK_POW_DIFFICULTY_LIMIT=5000000
SPK_HBA_NONCE_URL=https://apis.roblox.com/hba-service/v1/getServerNonce
SPK_POW_PUZZLE_URL=https://apis.roblox.com/proof-of-work-service/v1/pow-puzzle
SPK_CHALLENGE_CONTINUE_URL=https://apis.roblox.com/challenge/v1/continue
SPK_CAPTCHA_URL=https://apis.roblox.com/v2/captcha?urlLocale=en_us

# Прогрев страницы входа: без него платформа отвечает проверкой без
# идентификатора, и повторить обмен нечем.
SPK_PRIME_SESSION=true
